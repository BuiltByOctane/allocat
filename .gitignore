# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# android release signing secrets
android/app/keystore.properties
*.keystore
*.jks

# serwist / pwa service worker artifacts
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
/public/swe-worker-*.js.map
/public/workbox-*.js
/public/workbox-*.js.map

# Service-account private keys. These are secrets and belong in .env.local as
# base64 (PLAY_SA_JSON_B64 / FCM_SA_JSON_B64), never as loose files in the repo.
# The real copies live in ~/.allocat-keys/.
*-firebase-adminsdk-*.json
*.iam.gserviceaccount.com.json
allocat-*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]*.json
service-account*.json

# Local env backups
.env.local.bak-*
