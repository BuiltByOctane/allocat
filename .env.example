# ─── Supabase (required) ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL='https://your-project-ref.supabase.co'
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY='your-publishable-anon-key'

# Service role key — server-only (RLS bypass). Required for push notifications,
# the AI daily-usage counter, and the founding-member ledger.
# Get it from: Supabase dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY='your-service-role-key'

# ─── AI chat (optional) ──────────────────────────────────────────────────────
# https://openrouter.ai/keys — omit to disable /api/ai/chat
OPENROUTER_API_KEY='your-openrouter-api-key'

# ─── Web Push (optional) ─────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# Omit to disable browser push notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY='your-vapid-public-key'
VAPID_PUBLIC_KEY='your-vapid-public-key'
VAPID_PRIVATE_KEY='your-vapid-private-key'
VAPID_SUBJECT='mailto:you@example.com'

# ─── Admin portal (optional) ─────────────────────────────────────────────────
# Comma-separated emails allowed into /admin. Server-only — never prefix with
# NEXT_PUBLIC. Unset or empty ⇒ /admin 404s for everyone, which is the right
# default for any deploy that isn't yours.
ADMIN_EMAILS='you@example.com'

# Shared secret for the nightly Play install sync (Vercel Cron sends it as
# `Authorization: Bearer <secret>`). Omit and /api/admin/cron/play-sync returns
# 503; the "Sync now" button in /admin/growth still works.
CRON_SECRET='a-long-random-string'

# ─── Google Play install stats (optional) ────────────────────────────────────
# Play exposes no REST API for installs; the numbers come from the bulk-report
# CSVs in the developer account's Cloud Storage bucket.
#   1. GCP → service account → JSON key
#   2. Play Console → Users and permissions → invite that service-account email
#      → grant "View app information and download bulk reports"
#   3. Play Console → Download reports → Statistics → copy the bucket id
# Store the key as base64:  base64 -i service-account.json | tr -d '\n'
PLAY_SA_JSON_B64='base64-of-your-service-account-json'
PLAY_BUCKET='pubsite_prod_1234567890123456789'
PLAY_PACKAGE='com.octane.allocat'

# ─── Firebase Cloud Messaging (optional) ─────────────────────────────────────
# Push to the installed Android app. Web push (VAPID above) only reaches
# browsers and PWAs — the Capacitor shell has no Web Push API, so it needs FCM.
# Firebase Console → Project settings → General → Project ID
FCM_PROJECT_ID='your-firebase-project-id'
# Firebase Console → Project settings → Service accounts → Generate new private
# key.  base64 -i <file> | tr -d '\n'
FCM_SA_JSON_B64='base64-of-your-firebase-admin-sdk-json'

# ─── Product analytics (optional) ────────────────────────────────────────────
# PostHog project API key (Project settings → Project API key). Unset ⇒ the
# SDK never loads. Events go through the first-party /ingest proxy.
NEXT_PUBLIC_POSTHOG_KEY='phc_...'
# Ingest host the /ingest rewrite forwards to (EU: https://eu.i.posthog.com).
NEXT_PUBLIC_POSTHOG_HOST='https://us.i.posthog.com'
# Dashboard host, used for the toolbar (EU: https://eu.posthog.com).
NEXT_PUBLIC_POSTHOG_UI_HOST='https://us.posthog.com'
